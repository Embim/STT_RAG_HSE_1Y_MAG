# ─────────────────────────────────────────────────────────────────────────────
# Астролябия — шаблон .env. Скопируй в .env и заполни <...>.
# Прод-деплой по шагам: docs/deploy.md ; сеть/проброс портов: docs/runbook-network.md
# Секреты сгенерировать (WSL2/Linux):  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM (OpenRouter) ─────────────────────────────────────────────────────────
LLM_MODEL=openai/gpt-4o-mini
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY_1=<sk-or-...>
LLM_API_KEY_2=<sk-or-...>
LLM_API_KEY_3=<sk-or-...>
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# ── Auth (всё за логином, аккаунты выдаёт только админ) ──────────────────────
JWT_SECRET=<openssl rand -hex 32>
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<надёжный пароль>
AUTH_DB_PASSWORD=<надёжный пароль БД>

# ── Web / TLS ────────────────────────────────────────────────────────────────
DOMAIN=almagest.site
CERTBOT_EMAIL=<твой email>          # Let's Encrypt отвергает test@example.com
# ПЕРВЫЙ запуск — STAGING=1 (тестовый CA, не жжём лимит). После выпуска: STAGING=0.
STAGING=1
# Пусто = выключить self-signed CA (для боевого серта). Менять ТОЛЬКО на проде.
USE_LOCAL_CA=

# ── ASR авто-свап (опционально; см. docs/asr_model_selection.md) ─────────────
# Включать ТОЛЬКО с overlay docker-compose.autoswap.yml на доверенной GPU-машине.
ASR_AUTOSWAP_ENABLED=false
# DOCKER_GID=<stat -c '%g' /var/run/docker.sock>   # обычно 999/998, нужен при autoswap
# ASR_ACTIVE_MODEL=whisper                          # какая модель поднята, когда autoswap off

# ── Карта тем (опционально) ──────────────────────────────────────────────────
# EMBEDDING_MAP_REDUCER=auto   # auto|umap|pca (umap — только если собран extra `viz`)

# ── Embeddings / кэш HF ──────────────────────────────────────────────────────
WEAVIATE_VECTORIZER_BASE_URL=http://infinity:7997
HUGGINGFACE_CACHE=

# ── Langfuse (observability; VPN-only) ───────────────────────────────────────
LANGFUSE_ENABLED=True
LANGFUSE_PUBLIC_KEY=lf_pk_local
LANGFUSE_SECRET_KEY=lf_sk_local
LANGFUSE_BASE_URL=http://localhost:3000

# ── Transcription Judge (Qwen3.5-9B GGUF Q4, профиль asr-judge :8002) ────────
JUDGE_URL=http://localhost:8002
JUDGE_MODEL_REPO=unsloth/Qwen3.5-9B-GGUF
JUDGE_MODEL_FILE=Qwen3.5-9B-Q4_K_M.gguf
JUDGE_MODEL_ID=qwen3.5-9b-q4
JUDGE_NAME=qwen3_5_9b_q4
JUDGE_REASONING=True
JUDGE_TEMPERATURE=0.2
JUDGE_MAX_OUTPUT_TOKENS=24000
JUDGE_MAX_INPUT_CHARS=8000
JUDGE_PROMPT_DIR=prompts/judge
