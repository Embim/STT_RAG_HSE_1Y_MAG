LLM_API_KEY_1=
LLM_API_KEY_2=
LLM_API_KEY_3=
HUGGINGFACE_CACHE=
LLM_MODEL=openai/gpt-4o-mini
LLM_BASE_URL=https://openrouter.ai/api/v1

WEAVIATE_VECTORIZER_BASE_URL=http://infinity:7997
# Прочие настройки
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# Langfuse
LANGFUSE_ENABLED=True
LANGFUSE_PUBLIC_KEY=lf_pk_local
LANGFUSE_SECRET_KEY=lf_sk_local
LANGFUSE_BASE_URL=http://localhost:3000

# Transcription Judge (Qwen3.5-9B GGUF Q4 через llama.cpp server)
# Запуск: docker compose --profile asr-judge up -d  (порт :8002)
# Первый старт скачает ~5.5 GB GGUF из HF (см. JUDGE_MODEL_REPO/_FILE).
JUDGE_URL=http://localhost:8002
JUDGE_MODEL_REPO=unsloth/Qwen3.5-9B-GGUF
JUDGE_MODEL_FILE=Qwen3.5-9B-Q4_K_M.gguf
JUDGE_MODEL_ID=qwen3.5-9b-q4
JUDGE_NAME=qwen3_5_9b_q4
JUDGE_REASONING=True
JUDGE_TEMPERATURE=0.2
JUDGE_MAX_OUTPUT_TOKENS=24000
JUDGE_MAX_INPUT_CHARS=8000
JUDGE_PROMPT_DIR=prompts/judge